{
  "version": 1,
  "mode": "enforce",
  "caps": [{"window": "per_day", "amountCents": 500, "action": "block"}],
  "commandRules": [
    {"id": "network", "match": "network", "action": "ask"},
    {"id": "deploy", "match": "deploy", "action": "ask"},
    {"id": "package-publish", "match": "package-publish", "action": "ask"},
    {"id": "payment", "match": "payment", "action": "ask"},
    {"id": "force-push", "match": "force-push", "action": "block"},
    {"id": "outside-workspace-delete", "match": "outside-workspace-delete", "action": "block"}
  ],
  "guardPack": {"rules": {"inbox-reset-codes": "stop"}}
}
