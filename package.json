{
  "name": "@agentguard-run/codex-plugin",
  "version": "0.6.0",
  "description": "Stops a runaway burst of sub-agents until you allow it and shows where your Claude Code or Codex tokens went. Runs on your machine.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "AGENTGUARD_NOTIFY_SUPPRESS=1 node scripts/run-tests.cjs",
    "start": "node runtime/mcp.cjs",
    "build:compat": "node scripts/build-compat.cjs",
    "check:compat": "node scripts/build-compat.cjs --check",
    "postinstall": "node scripts/provision-dependencies.cjs",
    "test:claude": "AGENTGUARD_NOTIFY_SUPPRESS=1 AGENTGUARD_TEST_HOST=claude-code node scripts/run-tests.cjs",
    "test:hosts": "AGENTGUARD_NOTIFY_SUPPRESS=1 npm test && AGENTGUARD_NOTIFY_SUPPRESS=1 npm run test:claude",
    "setup:public-evals": "npm ci --ignore-scripts --prefix scripts/public-evals-deps",
    "score:public-evals": "node scripts/score-public-evals.cjs"
  },
  "dependencies": {
    "@agentguard-run/burn": "^0.7.0",
    "@agentguard-run/spend": "^0.22.0"
  },
  "files": [
    "plugin.json",
    "mcp.json",
    ".app.json",
    "hooks",
    "live",
    "runtime",
    "!runtime/receipt-format",
    "config",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/build-compat.cjs",
    "scripts/measure-benign.cjs",
    "scripts/measure-overhead.cjs",
    "scripts/print-trust-state.cjs",
    "scripts/probe-hooks.cjs",
    "scripts/provision-dependencies.cjs",
    "compat",
    "!compat/codex-0.154/agentguard/runtime/receipt-format",
    ".agents/plugins/marketplace.json",
    "docs",
    ".claude-plugin",
    ".mcp.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentguard-run/agentguard-codex-plugin.git"
  },
  "homepage": "https://agentguard.run",
  "devDependencies": {
    "fast-check": "^4.10.2",
    "sh-syntax": "^0.6.0"
  }
}
